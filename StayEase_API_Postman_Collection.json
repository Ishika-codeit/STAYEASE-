{
  "info": {
    "name": "StayEase+ API Collection",
    "description": "Complete production API collection for StayEase+ accommodation marketplace.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"newuser@stayease.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"password123\",\n  \"role\": \"guest\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/signup" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guest@stayease.com\",\n  \"password\": \"guest123\",\n  \"role\": \"guest\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login" }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me" }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Varanasi\",\n  \"bio\": \"StayEase Explorer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/profile" }
          }
        }
      ]
    },
    {
      "name": "2. Listings",
      "item": [
        {
          "name": "Get All Listings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/listings?category=Student PG / Hostel" }
          }
        },
        {
          "name": "Get Listing By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/listings/{{listingId}}" }
          }
        },
        {
          "name": "Create Listing (Host)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hostToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Deluxe Student Studio\",\n  \"category\": \"Student PG / Hostel\",\n  \"location\": \"BHU, Varanasi\",\n  \"price\": \"₹5500 / month\",\n  \"description\": \"Clean and quiet student room.\",\n  \"roomType\": \"Single Room\",\n  \"amenities\": [\"WiFi\", \"AC\", \"Study Table\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/listings" }
          }
        },
        {
          "name": "Host My Listings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/listings/host/my-listings" }
          }
        }
      ]
    },
    {
      "name": "3. Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"name\": \"Ananya Saxena\",\n  \"phone\": \"9876501234\",\n  \"checkInDate\": \"2026-12-01\",\n  \"checkOutDate\": \"2026-12-31\",\n  \"guests\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings" }
          }
        },
        {
          "name": "Guest My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/my-bookings" }
          }
        },
        {
          "name": "Host Received Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bookings/host/received" }
          }
        }
      ]
    },
    {
      "name": "4. AI Features",
      "item": [
        {
          "name": "AI Recommendations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/ai/recommendations?category=Tourist Stay" }
          }
        },
        {
          "name": "AI Smart Natural Search",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"cheap student pg near BHU with wifi under 5000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ai/smart-search" }
          }
        },
        {
          "name": "AI Chat Concierge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What are the best coaching rooms in Kota?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ai/chat" }
          }
        },
        {
          "name": "AI Price Advisor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Student PG / Hostel\",\n  \"location\": \"Kota, Rajasthan\",\n  \"roomType\": \"Private Room\",\n  \"amenities\": [\"WiFi\", \"AC\", \"Mess\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ai/price-advisor" }
          }
        }
      ]
    },
    {
      "name": "5. Admin Portal",
      "item": [
        {
          "name": "Platform Statistics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/stats" }
          }
        },
        {
          "name": "All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users" }
          }
        },
        {
          "name": "All Platform Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/bookings" }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "hostToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "listingId", "value": "" }
  ]
}
